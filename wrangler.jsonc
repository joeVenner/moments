{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moments",
  "main": "src/worker/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "triggers": {
    // Hourly: lifecycle cleanup, upload finalize and the orphan sweep each do
    // a bounded batch per run (subrequest budget), so they need the cadence.
    "crons": ["0 * * * *"]
  },
  "routes": [
    {
      "pattern": "moments-hq.com",
      "custom_domain": true
    },
    {
      "pattern": "www.moments-hq.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/media/*", "/admin", "/admin/*", "/e/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moments-db",
      "database_id": "d8cccf07-dce8-4a30-a305-0ac0d0a7fb00"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "moments-media",
      "remote": true
    }
  ],
  "ratelimits": [
    {
      // Guest joins (web and app), per event and IP. Each join can mint a
      // guest with upload rights; generous because venue Wi-Fi puts many
      // guests behind one address.
      "name": "JOIN_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      // v1 upload sessions, keyed per guest session. A 50-item queue needs
      // about 150 calls (start, part URLs, status), so this leaves headroom.
      "name": "UPLOAD_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "ADMIN_AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "REACTION_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "GUEST_READ_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
