        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est partagé"
          }
        }
      }
    },
    "Allow camera access in Settings to scan event QR codes, or paste the event's link instead.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès à l'appareil photo dans Réglages pour scanner les QR codes, ou collez plutôt le lien de l'événement."
          }
        }
      }
    },
    "Anyone with the event link or QR code can open the event.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute personne ayant le lien ou le QR code de l'événement peut l'ouvrir."
          }
        }
      }
    },
    "Anyone with this link can open the event without its PIN. Share it only with your guests.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute personne ayant ce lien peut ouvrir l'événement sans son code. Ne le partagez qu'avec vos invités."
          }
        }
      }
    },
