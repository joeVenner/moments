    "A QR code for the tables, one live album for every guest, and every photo and video kept in full quality.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un QR code pour les tables, un album en direct pour tous les invités, et chaque photo et vidéo gardée en pleine qualité."
          }
        }
      }
    },
