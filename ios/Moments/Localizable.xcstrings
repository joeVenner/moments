    "Every moment, together": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque moment, ensemble"
          }
        }
      }
    },
    "Everyone will need the new PIN or invite link. Guests already in are signed out, and the old invite link stops working.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde aura besoin du nouveau code PIN ou du lien d'invitation. Les invités déjà présents sont déconnectés et l'ancien lien d'invitation ne fonctionne plus."
          }
        }
      }
    },
    "Finishing": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalisation"
          }
        }
      }
    },
    "For private events. It skips the PIN, so share it only with your guests.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les événements privés. Il permet d'entrer sans code : ne le partagez qu'avec vos invités."
          }
        }
      }
    },
    "Get started": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer"
          }
        }
      }
    },
    "Graduation": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remise de diplôme"
          }
        }
      }
    },
    "Guests": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invités"
          }
        }
      }
    },
    "Guests can share until then. A date that has passed closes uploads now.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les invités peuvent partager jusqu'à cette date. Une date passée arrête les partages tout de suite."
          }
        }
      }
    },
    "Guests can share until then. The event and its photos and videos are deleted afterwards.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les invités peuvent partager jusqu'à cette date. L'événement, ses photos et ses vidéos sont ensuite supprimés."
          }
        }
      }
    },
    "Guests need the PIN or the invite link to open the event.": {
      "localizations": {
        "fr": {
