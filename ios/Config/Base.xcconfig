// Shared build settings for the Moments app and its tests.
// Personal values (signing team, bundle prefix) go in Local.xcconfig, which
// is git-ignored; copy Local.xcconfig.example to start.

// Signing: set the team and prefix in Local.xcconfig, never in Xcode's
// Signing & Capabilities pane, which writes them into the tracked pbxproj
// (target settings would then silently override Local.xcconfig).
// Placeholder until the real prefix is chosen. An empty team is fine for the
// simulator; device builds fail until Local.xcconfig sets DEVELOPMENT_TEAM.
MOMENTS_BUNDLE_ID_PREFIX = com.example
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// Shared by the app, the App Clip and any extension (they must match).
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
CLANG_ENABLE_MODULES = YES
ALWAYS_SEARCH_USER_PATHS = NO
COPY_PHASE_STRIP = NO
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
STRING_CATALOG_GENERATE_SYMBOLS = YES
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
CLANG_ANALYZER_NONNULL = YES
GCC_NO_COMMON_BLOCKS = YES
ENABLE_NS_ASSERTIONS[config=Release] = NO

#include? "Local.xcconfig"
