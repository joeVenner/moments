{
  "name": "moments",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "predev": "wrangler d1 migrations apply moments-db --local",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply moments-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply moments-db --remote",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "openapi:update": "UPDATE_OPENAPI=1 vitest run src/worker/v1/openapi.test.ts",
    "verify:roadmap": "node scripts/verify-roadmap.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "ios:strings:check": "node scripts/check-ios-strings.mjs",
    "avatar:fixtures": "UPDATE_AVATAR_FIXTURES=1 vitest run src/client/lib/avatar.fixtures.test.ts",
    "seo:indexnow": "node scripts/submit-indexnow.mjs"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@hono/zod-openapi": "^1.6.3",
    "aws4fetch": "^1.0.20",
    "canvas-confetti": "^1.9.4",
    "fflate": "^0.8.3",
    "hono": "^4.12.27",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^2.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tus-js-client": "^4.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.2",
    "@cloudflare/workers-types": "^4.20250620.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.9",
    "wrangler": "^4.104.0"
  }
}
