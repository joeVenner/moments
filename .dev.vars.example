ADMIN_USER=changeme
ADMIN_PASSWORD=changeme
OPENAI_API_KEY=

# Presigned large direct-to-R2 uploads (P3.1). All three required to enable;
# leave blank and the presign endpoint returns 501. Mint from an R2 API token.
# Endpoint = https://<account-id>.r2.cloudflarestorage.com (default jurisdiction).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
R2_BUCKET_NAME=moments-media

# Cloudflare Stream direct creator uploads (tus). The API token needs Stream
# Edit permission. Leave any value blank to keep videos on the R2 fallback.
STREAM_ACCOUNT_ID=
STREAM_API_TOKEN=
STREAM_CUSTOMER_CODE=
# Optional: signed playback for private-event videos. Create a key with
# POST /accounts/<id>/stream/keys and copy result.id and result.jwk (base64) here.
STREAM_SIGNING_KEY_ID=
STREAM_SIGNING_JWK=

# Signs private-event access grants (any long random string, e.g. `openssl rand -hex 32`).
# Leave blank to keep the legacy unsigned invite-token cookie.
EVENT_ACCESS_SECRET=
